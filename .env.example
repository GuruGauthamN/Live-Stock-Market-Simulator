APP_NAME=stock-predicting-agent
DATA_DIR=data
ARTIFACTS_DIR=artifacts
SYMBOLS=AAPL,MSFT,GOOGL
STREAM_INTERVAL_SECONDS=1
NEWS_INTERVAL_SECONDS=20
NEWS_PROVIDER=newsapi
NEWS_API_KEY=put_your_newsapi_key_here
NEWS_LANGUAGE=en
MODEL_MIN_BARS=200
PREDICTION_HORIZON_BARS=5
SIGNAL_THRESHOLD=0.55
INVEST_NEWS_FLOOR=-0.10
AUTO_EXECUTE_DECISIONS=True
DECISION_TRADE_QTY=1
LLM_ENABLED=False
LLM_AUTO_RUN=False
LLM_API_KEY=put_your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_DECISION_INTERVAL_SECONDS=300
LLM_MIN_CONFIDENCE=0.60
MAX_POSITION_VALUE=5000
MAX_DAILY_LOSS=500
STARTING_CASH=100000
